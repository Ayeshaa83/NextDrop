# NextDrop - Unified Gitignore

# Dependencies
node_modules/
.venv/
venv/
env/
__pycache__/
*.pyc

# Next.js Build
.next/
out/
build/

# IDEs
.vscode/
.idea/
.DS_Store

# Environment Variables (Keep these private!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Misc
.vercel
dist/
