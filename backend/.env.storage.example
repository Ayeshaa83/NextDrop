# NextDrop Backend Storage Configuration
# =====================================
# Copy this file to .env and fill in your credentials

# Storage Provider: s3 | r2 | spaces | minio
STORAGE_PROVIDER=r2

# Access Credentials
STORAGE_ACCESS_KEY_ID=your_access_key_here
STORAGE_SECRET_ACCESS_KEY=your_secret_key_here

# Bucket Configuration
STORAGE_BUCKET_NAME=nextdrop
STORAGE_REGION=auto

# Endpoint URL (required for R2, Spaces, MinIO)
# Cloudflare R2: https://{account_id}.r2.cloudflarestorage.com
# DigitalOcean Spaces: https://{region}.digitaloceanspaces.com
# MinIO: http://localhost:9000
STORAGE_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Public CDN URL (optional - for serving files via CDN)
# If set, download URLs will use this domain instead of presigned URLs
# STORAGE_PUBLIC_URL=https://cdn.yourdomain.com

# URL Expiration (in seconds)
STORAGE_UPLOAD_EXPIRATION=3600
STORAGE_DOWNLOAD_EXPIRATION=86400


# =====================================
# PROVIDER-SPECIFIC SETUP GUIDES
# =====================================

# CLOUDFLARE R2 (Recommended - Cheapest for streaming)
# ----------------------------------------------------
# 1. Go to Cloudflare Dashboard > R2
# 2. Create a bucket named "nextdrop"
# 3. API Tokens > Create API token
# 4. Select "Admin Read & Write" permissions
# 5. Copy Access Key ID and Secret Access Key
# 6. Endpoint: https://{account_id}.r2.cloudflarestorage.com
# 7. (Optional) Set up a custom domain for public access

# AWS S3
# ------
# 1. Create an S3 bucket in your preferred region
# 2. Create an IAM user with S3 access
# 3. Generate access keys for the IAM user
# 4. STORAGE_PROVIDER=s3
# 5. Leave STORAGE_ENDPOINT_URL empty (uses AWS default)

# DIGITALOCEAN SPACES
# -------------------
# 1. Create a Space in your preferred region
# 2. API > Spaces Keys > Generate New Key
# 3. STORAGE_PROVIDER=spaces
# 4. STORAGE_ENDPOINT_URL=https://{region}.digitaloceanspaces.com

# MINIO (Self-hosted)
# -------------------
# 1. Run MinIO: docker run -p 9000:9000 minio/minio server /data
# 2. Access MinIO console at http://localhost:9000
# 3. Create bucket and access keys
# 4. STORAGE_PROVIDER=minio
# 5. STORAGE_ENDPOINT_URL=http://localhost:9000

COOKIE_SECURE=true       # Requires HTTPS
COOKIE_SAMESITE=strict   # Or "none" for cross-origin
COOKIE_DOMAIN=.yourdomain.com