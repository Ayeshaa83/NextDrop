# NextDrop backend configuration — copy to .env and fill in real values.
# Never commit the real .env file.

PROJECT_NAME=NextDrop
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: force a specific IP for the DB host (workaround for DNS issues)
DATABASE_HOSTADDR=

# JWT / crypto — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/spotify/callback

# Google / YouTube OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback

# Meta / Instagram (optional)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
DEMO_MODE=true

# Object storage (S3 / R2 / Spaces / MinIO). Leave blank to use local uploads/ mock.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=

# AI insights (optional — heuristic fallbacks are used when absent)
ANTHROPIC_API_KEY=

# Email via Gmail SMTP (optional — emails are logged to console when absent).
# SMTP_USER = your Gmail address; SMTP_PASSWORD = a Google "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=NextDrop
