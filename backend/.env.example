# NextDrop backend configuration — copy to .env and fill in real values.
# Never commit the real .env file.

PROJECT_NAME=NextDrop
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: force a specific IP for the DB host (workaround for DNS issues)
DATABASE_HOSTADDR=

# JWT / crypto — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/spotify/callback

# Google Sign-In — separate OAuth client from YouTube below (only needs
# openid/email/profile scope). Create it at https://console.cloud.google.com
# -> APIs & Services -> Credentials -> OAuth client ID -> Web application,
# and add GOOGLE_REDIRECT_URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# YouTube OAuth (channel stats integration — different client than above)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback

# Meta / Instagram (optional)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
DEMO_MODE=true

# Object storage (S3 / R2 / Spaces / MinIO / Supabase). Leave blank to use local uploads/ mock.
# provider is one of: s3 | r2 | spaces | minio  (Supabase uses "s3" — its Storage is S3-compatible)
STORAGE_PROVIDER=s3
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_PUBLIC_URL=
#
# Supabase setup: Project Settings -> Storage -> S3 Connection tab gives you
# STORAGE_ENDPOINT_URL (https://<project-ref>.supabase.co/storage/v1/s3) and
# STORAGE_REGION. On that same page, generate a new S3 access key pair (not
# your anon/service_role API keys) for STORAGE_ACCESS_KEY_ID/SECRET. Create a
# bucket in Storage and put its name in STORAGE_BUCKET_NAME. If left Private,
# uploads still work via a 7-day presigned URL; make the bucket Public and
# set STORAGE_PUBLIC_URL (https://<project-ref>.storage.supabase.co/storage/v1/object/public/<bucket>)
# for links that never expire.

# Optional: route avatar uploads to their own bucket instead of STORAGE_BUCKET_NAME
# (e.g. a dedicated "artist-image" bucket). Leave both blank to keep avatars in
# the default bucket alongside tracks/covers.
STORAGE_BUCKET_AVATARS=
STORAGE_PUBLIC_URL_AVATARS=

# AI insights (optional — heuristic fallbacks are used when absent)
ANTHROPIC_API_KEY=

# MusicCNN needs tensorflow==1.15 + numpy<1.17, which conflict with the app's
# modern dependencies, so it runs in an isolated Python 3.7 interpreter.
# See ai_engine/README.md for how to create it. Leave blank to skip tagging
# (metadata suggestions fall back to heuristics; nothing else breaks).
# Local (Windows): musicnn_env/Scripts/python.exe
# Docker/Linux:     /opt/musicnn_env/bin/python
MUSICNN_PYTHON_PATH=

# Email via Gmail SMTP (optional — emails are logged to console when absent).
# SMTP_USER = your Gmail address; SMTP_PASSWORD = a Google "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=NextDrop

# ISRC Code Generation Defaults
ISRC_COUNTRY_CODE=IN
ISRC_REGISTRANT_CODE=ND1
